---
import BaseLayout from '../layouts/BaseLayout.astro';
import pontcirq1 from '../assets/accueil/pontcirq-1.jpg';
import pontcirq2 from '../assets/accueil/pontcirq-2.jpg';
import pontcirq3 from '../assets/accueil/pontcirq-3.jpg';
import pontcirq4 from '../assets/accueil/pontcirq-4.jpg';
import pontcirq5 from '../assets/accueil/pontcirq-5.jpg';
import pontcirq6 from '../assets/accueil/pontcirq-6.jpg';
import pontcirq7 from '../assets/accueil/pontcirq-7.jpg';
import Carousel from '../components/Carousel.astro';
import ActualiteCard from '../components/ActualiteCard.astro';
import { getHighlights } from '../data/actualites';
import { address, phone, email, openingHours, emergencyNumbers } from '../data/mairie';

const latestNews = getHighlights(3);

const slides = [
  { src: pontcirq1, alt: "L'église et le clocher de Pontcirq" },
  { src: pontcirq2, alt: 'Vue du village de Pontcirq' },
  { src: pontcirq3, alt: 'Paysage autour de Pontcirq' },
  { src: pontcirq4, alt: 'Le patrimoine bâti de Pontcirq' },
  { src: pontcirq5, alt: 'Ruelle du village de Pontcirq' },
  { src: pontcirq6, alt: 'Campagne environnant Pontcirq' },
  { src: pontcirq7, alt: 'Pontcirq vu depuis les alentours' },
];
---

<BaseLayout title="Accueil">
  <section class="hero">
    <h1>Bienvenue à Pontcirq</h1>
    <p class="lead">
      Petite commune rurale aux portes du Quercy blanc, Pontcirq vous accueille dans un cadre
      de vie paisible entre causses et vallées.
    </p>
  </section>

  <section class="card infos" aria-labelledby="infos-title">
    <div class="infos-header">
      <h2 id="infos-title">Infos pratiques</h2>
      <a href="/mairie" class="news-link">La mairie &rarr;</a>
    </div>
    <div class="infos-grid">
      <div>
        <h3>Mairie</h3>
        <p><a href={address.href}>{address.label}</a></p>
        <p><a href={phone.href}>{phone.label}</a></p>
        <p><a href={email.href} class="infos-email">{email.label}</a></p>
      </div>
      <div>
        <h3>Horaires d'ouverture</h3>
        {openingHours.map((h) => <p>{h.day} : <strong>{h.label}</strong></p>)}
      </div>
      <div>
        <h3>Urgences</h3>
        <ul class="emergency">
          {emergencyNumbers.map((n) => (
            <li>
              <a href={n.href}><strong>{n.number}</strong> {n.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="gallery">
    <Carousel slides={slides} />
  </section>

  <section class="news">
    <div class="news-header">
      <h2>Dernières actualités</h2>
      <a href="/actualites" class="news-link news-link--top">Toutes les actualités &rarr;</a>
    </div>
    <div class="news-grid">
      {latestNews.map((item) => <ActualiteCard actualite={item} showImage={false} showAssociation={false} />)}
    </div>
    <a href="/actualites" class="news-link news-link--bottom">Toutes les actualités &rarr;</a>
  </section>

  <section class="explore">
    <h2>Explorer le site</h2>
  </section>

  <section class="highlights">
    <a class="card highlight" href="/mairie">
      <span class="highlight-icon">🏛️</span>
      <h3>La mairie</h3>
      <p>Horaires d'ouverture, coordonnées, démarches administratives et informations pratiques.</p>
      <span class="highlight-link">En savoir plus &rarr;</span>
    </a>
    <a class="card highlight" href="/vie-locale">
      <span class="highlight-icon">🤝</span>
      <h3>Vie locale</h3>
      <p>Associations, commerces et rendez-vous qui font la vie du village.</p>
      <span class="highlight-link">En savoir plus &rarr;</span>
    </a>
    <a class="card highlight" href="/actualites">
      <span class="highlight-icon">📰</span>
      <h3>Actualités</h3>
      <p>Suivez les dernières annonces et actualités de la commune.</p>
      <span class="highlight-link">En savoir plus &rarr;</span>
    </a>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 2.5rem 1.5rem;
    margin: 0 -1.5rem 1.5rem;
    text-align: center;
    background: radial-gradient(circle at top, var(--color-primary-light) 0%, var(--color-bg) 70%);
    border-radius: 0 0 2rem 2rem;
  }

  .hero h1 {
    font-size: clamp(1.85rem, 4vw, 2.5rem);
    margin: 0 0 0.5rem;
  }

  .lead {
    max-width: 52rem;
    margin: 0 auto;
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .lead strong {
    color: var(--color-primary);
  }

  .gallery {
    margin: 0 0 1.5rem;
  }

  .infos {
    margin: 0 0 1.5rem;
    padding: 1.25rem 1.5rem;
  }

  .infos-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .infos-header h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .infos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem 1.5rem;
  }

  .infos h3 {
    margin: 0 0 0.35rem;
    font-size: 0.95rem;
    color: var(--color-primary);
  }

  .infos p {
    margin: 0.15rem 0;
    font-size: 0.92rem;
  }

  .infos-email {
    overflow-wrap: anywhere;
  }

  .emergency {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem 1rem;
    font-size: 0.92rem;
  }

  .emergency strong {
    color: var(--color-accent);
    margin-right: 0.25rem;
  }

  .news {
    margin: 2.5rem 0;
  }

  .news-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .news-header h2 {
    margin: 0;
    font-size: 1.5rem;
  }

  .news-link {
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .news-link--bottom {
    display: none;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .news-header {
      justify-content: flex-start;
    }

    .news-link--top {
      display: none;
    }

    .news-link--bottom {
      display: inline-block;
      margin-top: 1.25rem;
    }
  }

  .explore h2 {
    margin: 0;
    font-size: 1.5rem;
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin: 1.25rem 0 3rem;
  }

  .highlight {
    color: var(--color-text);
    display: flex;
    flex-direction: column;
  }

  .highlight:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
    color: var(--color-text);
  }

  .highlight-icon {
    font-size: 1.75rem;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary-light);
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
  }

  .highlights h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }

  .highlights p {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    margin: 0 0 1rem;
    flex-grow: 1;
  }

  .highlight-link {
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
