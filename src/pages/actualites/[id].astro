---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { actualites, getById, getActualiteImage, getActualiteWhen } from '../../data/actualites';

export function getStaticPaths() {
  return actualites.map((item) => ({
    params: { id: String(item.id) },
  }));
}

const id = Number(Astro.params.id);
const actualite = getById(id)!;
const when = getActualiteWhen(actualite);
const source = getActualiteImage(actualite);
// getImage() rather than <Image> so the output dimensions are known without reading width/height on the
// source (which would make Astro also publish the unoptimised original).
const image = source && (await getImage({ src: source, widths: [480, 800, 1200, 1600], loading: 'eager' }));
// The image is capped at 32rem high (object-fit: contain), so portrait posters render much narrower than the column
const imageMaxWidthRem = image
  ? Math.min(72, Math.ceil((32 * Number(image.attributes.width)) / Number(image.attributes.height)))
  : 72;
const { Content } = await render(actualite.entry);
---

<BaseLayout title={actualite.title} description={actualite.excerpt} image={source} type="article">
  <a href="/actualites" class="back-link">&larr; Retour aux actualités</a>

  <article class="news-detail">
    {image && (
      <img
        {...image.attributes}
        class="news-detail-image"
        src={image.src}
        srcset={image.srcSet.attribute}
        sizes={`(max-width: ${imageMaxWidthRem}rem) 100vw, ${imageMaxWidthRem}rem`}
        alt=""
      />
    )}
    <div class="news-detail-meta">
      <time datetime={when.datetime}>{when.date}{when.time && <span class="news-detail-hour"> · {when.time}</span>}</time>
      <StatusBadge actualite={actualite} />
    </div>
    {actualite.lieu && <p class="news-detail-lieu">{actualite.lieu}</p>}
    <h1>{actualite.title}</h1>
    <div class="news-detail-content"><Content /></div>
    {actualite.associations && actualite.associations.length > 0 && (
      <p class="news-detail-assoc">
        Organisé par
        {' '}
        {actualite.associations.map((assoc, i) => (
          <>
            {i > 0 && ' et '}
            <a href={`/vie-locale#${assoc.anchor}`}>{assoc.name}</a>
          </>
        ))}
      </p>
    )}
  </article>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    margin: 1.5rem 0 1rem;
    color: var(--color-text-muted);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .news-detail {
    margin-bottom: 3rem;
  }

  .news-detail-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .news-detail time {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .news-detail-hour {
    text-transform: none;
  }

  .news-detail-lieu {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .news-detail-image {
    display: block;
    width: 100%;
    max-height: 32rem;
    object-fit: contain;
    background: var(--color-surface);
    border-radius: var(--radius);
    margin-bottom: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .news-detail h1 {
    margin: 0 0 1.25rem;
  }

  .news-detail-content {
    color: var(--color-text);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 52rem;
  }

  .news-detail-content :global(p) {
    margin: 0 0 1rem;
  }

  .news-detail-content :global(a) {
    color: var(--color-primary);
  }

  .news-detail-content :global(ul),
  .news-detail-content :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }

  .news-detail-assoc {
    margin-top: 1.5rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .news-detail-assoc a {
    color: var(--color-primary);
    font-weight: 600;
  }
</style>
