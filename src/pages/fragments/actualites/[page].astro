---
import ActualiteCard from '../../../components/ActualiteCard.astro';
import { getPage, getTotalPages } from '../../../data/actualites';

export function getStaticPaths() {
  const totalPages = getTotalPages();
  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: String(i + 1) },
  }));
}

const page = Number(Astro.params.page);
const items = getPage(page);
const totalPages = getTotalPages();
const hasNext = page < totalPages;
---

{items.map((item) => <ActualiteCard actualite={item} layout="row" />)}

{hasNext && (
  <div
    class="load-more-trigger"
    hx-get={`/fragments/actualites/${page + 1}.html`}
    hx-trigger="revealed"
    hx-swap="outerHTML"
  >
    <p class="htmx-indicator">Chargement…</p>
  </div>
)}

{!hasNext && items.length > 0 && (
  <p class="end-of-list">Vous avez tout lu &mdash; à bientôt pour de nouvelles actualités !</p>
)}

<style>
  .end-of-list {
    text-align: center;
    color: var(--color-text-muted);
    font-style: italic;
    margin: 1.5rem 0;
  }

  .load-more-trigger {
    min-height: 2rem;
  }
</style>
