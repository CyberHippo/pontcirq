---
import { Image } from 'astro:assets';
import bibliotheque from '../assets/vie-locale/bibliotheque.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import { associations, associationAnchor, LIBRARY_ANCHOR } from '../data/associations';

const ecoles = [
  {
    name: 'Labastide-du-Vert',
    cycle: 'École maternelle',
    levels: 'Petite, moyenne et grande sections',
  },
  {
    name: 'Lherm',
    cycle: 'École élémentaire',
    levels: 'CP, CE1 et CE2',
  },
  {
    name: 'Les Junies',
    cycle: 'École élémentaire',
    levels: 'CE2, CM1 et CM2',
  },
];

const marches = [
  {
    day: 'Lundi soir',
    places: [
      {
        label: 'Castelfranc à 8 km',
        href: 'https://www.tourisme-lot.com/offres/marche-de-castelfranc-castelfranc-fr-4214447/',
      },
    ],
  },
  {
    day: 'Mardi matin',
    places: [
      {
        label: 'Catus à 8 km',
        href: 'https://www.tourisme-lot.com/offres/marche-a-catus-catus-fr-1036361/',
      },
    ],
  },
  {
    day: 'Mercredi matin',
    places: [
      {
        label: 'Cahors à 22 km',
        href: 'https://www.tourisme-lot.com/offres/marche-a-cahors-cahors-fr-3457366/',
      },
      {
        label: 'Luzech à 12 km',
        href: 'https://www.tourisme-lot.com/offres/marche-a-luzech-luzech-fr-687258/',
      },
    ],
  },
  {
    day: 'Jeudi matin',
    places: [
      {
        label: 'Mercues à 14 km',
        href: 'https://www.tourisme-lot.com/offres/marche-a-mercues-mercues-fr-1036319/',
      },
    ],
  },
  {
    day: 'Vendredi matin',
    places: [
      {
        label: 'Prayssac à 11 km',
        href: 'https://www.tourisme-lot.com/offres/marche-a-prayssac-prayssac-fr-687275/',
      },
    ],
  },
  {
    day: 'Samedi matin',
    places: [
      {
        label: 'Cahors',
        href: 'https://www.tourisme-lot.com/offres/marche-a-cahors-cahors-fr-3457366/',
      },
    ],
  },
  {
    day: 'Dimanche matin',
    places: [
      {
        label: 'Espère à 12 km',
        href: 'https://www.tourisme-lot.com/offres/marche-a-espere-espere-fr-1036354/',
      },
      {
        label: 'Montcuq à 32 km',
        href: 'https://www.tourisme-lot.com/offres/marche-a-montcuq-montcuq-en-quercy-blanc-fr-1036315/',
      },
    ],
  },
];
---

<BaseLayout title="Vie locale" description="Associations et vie locale de la commune de Pontcirq.">
  <h1>Vie locale</h1>

  <section>
    <h2>Associations</h2>
    <ul class="assoc-list">
      {associations.map((assoc) => (
        <li class="card" id={associationAnchor(assoc.name)}>
          <div class="assoc-header">
            {assoc.logo && (
              <Image src={assoc.logo} alt="" width={64} height={64} densities={[1, 2]} />
            )}
            <h3>{assoc.name}</h3>
          </div>
          <p>{assoc.desc}</p>
          {assoc.contact && (
            <p class="contact">
              {assoc.contact.includes('@') ? (
                <a href={`mailto:${assoc.contact}`}>{assoc.contact}</a>
              ) : (
                assoc.contact
              )}
            </p>
          )}
          {assoc.website && (
            <p class="contact">
              <a href={assoc.website} target="_blank" rel="noopener">Voir le site &rarr;</a>
            </p>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Bibliothèque communale</h2>
    <div class="card library-card" id={LIBRARY_ANCHOR}>
      <Image
        src={bibliotheque}
        alt="Intérieur de la bibliothèque de Pontcirq"
        widths={[400, 800, 1200]}
        sizes="(max-width: 640px) 100vw, 24rem"
      />
      <div>
        <p>
          <a href="geo:0,0?q=56+Rue+de+l%27%C3%A9glise%2C+46150+Pontcirq">56 Rue de l'église, 46150 Pontcirq</a>
        </p>
        <p>Mercredi : 16h30 &ndash; 18h<br />Samedi : 10h30 &ndash; 12h30</p>
        <p><a href="mailto:bibliotheque.pontcirq@gmail.com">bibliotheque.pontcirq@gmail.com</a></p>
        <p>
          <a href="https://www.facebook.com/bibliothequepontcirq/" target="_blank" rel="noopener">
            Suivre la page Facebook &rarr;
          </a>
        </p>
      </div>
    </div>
  </section>

  <section>
    <h2>École (RPI)</h2>
    <p class="section-intro">
      Pontcirq n'a plus d'école ouverte : les enfants sont scolarisés au sein du regroupement pédagogique
      intercommunal (RPI n° 22 du Lot), qui réunit les communes de Labastide-du-Vert, Les Junies, Lherm et
      Pontcirq. Les classes sont réparties sur trois sites :
    </p>
    <ul class="ecoles">
      {ecoles.map((ecole) => (
        <li class="card">
          <h3>{ecole.name}</h3>
          <p class="ecole-cycle">{ecole.cycle}</p>
          <p>{ecole.levels}</p>
        </li>
      ))}
    </ul>
    <p>Le ramassage scolaire est assuré par le Conseil départemental du Lot.</p>
    <p>
      L'association des parents d'élèves du RPI (<a href={`#${associationAnchor('APE 3LP')}`}>APE 3LP</a>)
      organise chaque année des événements dont les fonds récoltés sont reversés intégralement et
      équitablement entre les écoles du regroupement.
    </p>
  </section>

  <section>
    <h2>Marchés du coin</h2>
    <p class="section-intro">Aucun marché à Pontcirq même, mais plusieurs marchés hebdomadaires à proximité.</p>
    <ul class="marches-list">
      {marches.map((marche) => (
        <li class="card">
          <h3>{marche.day}</h3>
          <ul class="places">
            {marche.places.map((place) => (
              <li>
                {place.href ? (
                  <a href={place.href} target="_blank" rel="noopener">{place.label}</a>
                ) : (
                  place.label
                )}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </section>

  <section id="randonnee">
    <h2>Randonnée</h2>
    <div class="card rando-card">
      <h3>Chemin des chevaliers</h3>
      <ul class="rando-facts">
        <li><strong>4,5 km</strong> en boucle</li>
        <li><strong>1h30</strong> à pied</li>
        <li><strong>Facile</strong></li>
        <li>Balisage <strong>jaune</strong></li>
      </ul>
      <p>
        Au départ de la mairie, cette petite boucle monte au-dessus du village par le lieu-dit La Crouzette,
        traverse le hameau de Tourniac, passe par Le Rège puis redescend par La Bastide, son château d'eau et son
        pigeonnier, avec un joli point de vue sur le village de Pontcirq. Prévoyez des chaussures adaptées et
        des vêtements imperméables.
      </p>
      <ul class="rando-links">
        <li>
          <a href="https://cdt46.media.tourinsoft.eu/upload/Fiche-Rando-PR-PONTCIRQ.pdf" target="_blank" rel="noopener">
            Fiche de l'itinéraire avec carte (PDF)
          </a>
        </li>
        <li>
          <a href="https://cdt46.media.tourinsoft.eu/upload/2022-10-24-PR-PONTCIRQ.gpx">Trace GPX</a>
        </li>
        <li>
          <a href="https://www.cahorsvalleedulot.com/itineraires/chemin-des-chevaliers/" target="_blank" rel="noopener">
            Sur le site de l'Office de tourisme Cahors – Vallée du Lot &rarr;
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .assoc-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(4, auto);
    grid-auto-flow: column;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2.5rem;
  }

  @media (max-width: 560px) {
    .assoc-list {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-auto-flow: row;
    }
  }

  .assoc-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .assoc-header img {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
  }

  .assoc-list h3 {
    margin: 0;
  }

  .assoc-list p {
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .assoc-list .contact {
    margin-top: 0.5rem;
    font-size: 0.85rem;
  }

  .assoc-list .contact a {
    color: var(--color-primary);
  }

  .ecoles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 1.5rem;
  }

  .ecoles h3 {
    margin: 0 0 0.25rem;
    font-size: 1.1rem;
  }

  .ecoles p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .ecoles .ecole-cycle {
    color: var(--color-primary);
    font-weight: 600;
  }

  .section-intro {
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .rando-card {
    margin: 1.5rem 0 2.5rem;
    max-width: 48rem;
  }

  .rando-card h3 {
    margin-top: 0;
  }

  .rando-card p {
    color: var(--color-text-muted);
  }

  .rando-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 1rem;
  }

  .rando-facts li {
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    font-size: 0.9rem;
  }

  .rando-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .rando-links li {
    margin-top: 0.4rem;
  }

  .rando-links a {
    font-weight: 600;
  }

  .marches-list {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2.5rem;
  }

  .marches-list li {
    display: flex;
    flex-direction: column;
    padding: 1.1rem 1rem;
  }

  .marches-list h3 {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
  }

  .marches-list .places {
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    flex-grow: 1;
  }

  .marches-list .places a {
    color: var(--color-primary);
  }

  .marches-list .places li {
    padding: 0.15rem 0;
  }

  @media (max-width: 900px) {
    .marches-list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 640px) {
    .marches-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .library-card {
    display: grid;
    grid-template-columns: 24rem 1fr;
    gap: 1.5rem;
    align-items: center;
    margin: 1.5rem 0 2.5rem;
    padding: 0;
    overflow: hidden;
  }

  .library-card img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .library-card > div {
    padding: 1.5rem 1.5rem 1.5rem 0;
  }

  .library-card p {
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .library-card {
      grid-template-columns: 1fr;
    }

    .library-card > div {
      padding: 0 1.5rem 1.5rem;
    }
  }
</style>
