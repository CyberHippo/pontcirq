---
import BaseLayout from '../layouts/BaseLayout.astro';
import { slugify } from '../utils/slugify';

const associations = [
  {
    name: 'ACCA de Pontcirq',
    desc: 'Association Communale de Chasse Agréée.',
    contact: '',
  },
  {
    name: 'Association de Sauvegarde du Patrimoine',
    desc: 'Préservation et valorisation du patrimoine communal.',
    contact: '',
  },
  {
    name: 'Equi-Vox – Le petit ranch',
    desc: 'Activités équestres et loisirs.',
    contact: 'equivox.asso@gmail.com',
  },
  {
    name: "FESTI'PONTCIRQ",
    desc: 'Organisation de festivités et animations locales.',
    contact: 'festipontcirq@gmail.com',
  },
  {
    name: 'La Gariotte, café associatif de Pontcirq',
    desc: 'Café associatif et lieu de convivialité du village.',
    contact: 'lagariottepontcirq@gmail.com',
  },
  {
    name: 'Les amis de Pontcirq',
    desc: 'Animations et loisirs pour les habitants.',
    contact: '',
  },
  {
    name: 'Lo Garric',
    desc: 'Association culturelle.',
    contact: 'francisbarascou@gmail.com',
  },
  {
    name: 'APE 3LP',
    desc: "Association des parents d'élèves du RPI Labastide-du-Vert, Les Junies, Lherm et Pontcirq.",
    contact: '3lp.ape@gmail.com',
  },
  {
    name: 'Unis Vers Terre',
    desc: "Laboratoire d'écologie globale cultivant l'autonomie, la coopération humaine et la transition intérieure à travers la permaculture.",
    contact: 'asso.unisversterre (at) gmail.com',
    website: 'https://unisversterre.wordpress.com/',
  },
];

const marches = [
  {
    day: 'Lundi soir',
    places: [
      {
        label: 'Castelfranc à 8 km',
        href: 'https://www.tourisme-lot.com/offres/marche-de-castelfranc-castelfranc-fr-4214447/',
      },
    ],
  },
  {
    day: 'Mardi matin',
    places: [
      {
        label: 'Catus à 8 km',
        href: 'https://www.tourisme-lot.com/offres/marche-a-catus-catus-fr-1036361/',
      },
    ],
  },
  {
    day: 'Mercredi matin',
    places: [
      {
        label: 'Cahors à 22 km',
        href: 'https://www.tourisme-lot.com/offres/marche-a-cahors-cahors-fr-3457366/',
      },
      {
        label: 'Luzech à 12 km',
        href: 'https://www.tourisme-lot.com/offres/marche-a-luzech-luzech-fr-687258/',
      },
    ],
  },
  {
    day: 'Jeudi matin',
    places: [
      {
        label: 'Mercues à 14 km',
        href: 'https://www.tourisme-lot.com/offres/marche-a-mercues-mercues-fr-1036319/',
      },
    ],
  },
  {
    day: 'Vendredi matin',
    places: [
      {
        label: 'Prayssac à 11 km',
        href: 'https://www.tourisme-lot.com/offres/marche-a-prayssac-prayssac-fr-687275/',
      },
    ],
  },
  {
    day: 'Samedi matin',
    places: [
      {
        label: 'Cahors',
        href: 'https://www.tourisme-lot.com/offres/marche-a-cahors-cahors-fr-3457366/',
      },
    ],
  },
  {
    day: 'Dimanche matin',
    places: [
      {
        label: 'Espère à 12 km',
        href: 'https://www.tourisme-lot.com/offres/marche-a-espere-espere-fr-1036354/',
      },
      {
        label: 'Montcuq à 32 km',
        href: 'https://www.tourisme-lot.com/offres/marche-a-montcuq-montcuq-en-quercy-blanc-fr-1036315/',
      },
    ],
  },
];
---

<BaseLayout title="Vie locale" description="Associations et vie locale de la commune de Pontcirq.">
  <h1>Vie locale</h1>

  <section>
    <h2>Associations</h2>
    <ul class="assoc-list">
      {associations.map((assoc) => (
        <li class="card" id={`assoc-${slugify(assoc.name)}`}>
          <h3>{assoc.name}</h3>
          <p>{assoc.desc}</p>
          {assoc.contact && (
            <p class="contact">
              {assoc.contact.includes('@') ? (
                <a href={`mailto:${assoc.contact}`}>{assoc.contact}</a>
              ) : (
                assoc.contact
              )}
            </p>
          )}
          {assoc.website && (
            <p class="contact">
              <a href={assoc.website} target="_blank" rel="noopener">Voir le site &rarr;</a>
            </p>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Bibliothèque communale</h2>
    <div class="card library-card" id="assoc-bibliotheque-de-pontcirq">
      <img src="/images/vie-locale/bibliotheque.jpg" alt="Intérieur de la bibliothèque de Pontcirq" />
      <div>
        <h3>Bibliothèque de Pontcirq</h3>
        <p>56 Rue de l'église, 46150 Pontcirq</p>
        <p>Mercredi : 16h30 &ndash; 18h<br />Samedi : 10h30 &ndash; 12h30</p>
        <p><a href="mailto:bibliotheque.pontcirq@gmail.com">bibliotheque.pontcirq@gmail.com</a></p>
        <p>
          <a href="https://www.facebook.com/bibliothequepontcirq/" target="_blank" rel="noopener">
            Suivre la page Facebook &rarr;
          </a>
        </p>
      </div>
    </div>
  </section>

  <section>
    <h2> (RPI)</h2>
    <p>
      Les enfants de Pontcirq sont scolarisés au sein du regroupement pédagogique intercommunal (RPI)
      réunissant les communes de Labastide-du-Vert, Les Junies, Lherm et Pontcirq, en école maternelle
      et élémentaire. Ramassage scolaire assuré par le Conseil départemental du Lot.
    </p>
    <p>
      L'association des parents d'élèves du RPI (APE 3LP) organise chaque année des événements dont
      les fonds récoltés sont reversés intégralement et équitablement entre les écoles du regroupement.
    </p>
  </section>

  <section>
    <h2>Patrimoine</h2>
    <p>
      Pontcirq s'est bâti au flanc d'une anse couronnée de bois, offrant une vue harmonieuse sur la vallée.
      Le hameau de Tourniac conserve un très beau four à pain, vestige du patrimoine rural de la commune.
    </p>
  </section>

  <section>
    <h2>Marchés du coin</h2>
    <p class="section-intro">Aucun marché à Pontcirq même, mais plusieurs marchés hebdomadaires à proximité.</p>
    <ul class="marches-list">
      {marches.map((marche) => (
        <li class="card">
          <h3>{marche.day}</h3>
          <ul class="places">
            {marche.places.map((place) => (
              <li>
                {place.href ? (
                  <a href={place.href} target="_blank" rel="noopener">{place.label}</a>
                ) : (
                  place.label
                )}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .assoc-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2.5rem;
  }

  @media (max-width: 900px) {
    .assoc-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .assoc-list {
      grid-template-columns: 1fr;
    }
  }

  .assoc-list h3 {
    margin-top: 0;
  }

  .assoc-list p {
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .assoc-list .contact {
    margin-top: 0.5rem;
    font-size: 0.85rem;
  }

  .assoc-list .contact a {
    color: var(--color-primary);
  }

  .section-intro {
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .marches-list {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2.5rem;
  }

  .marches-list li {
    display: flex;
    flex-direction: column;
    padding: 1.1rem 1rem;
  }

  .marches-list h3 {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
  }

  .marches-list .places {
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    flex-grow: 1;
  }

  .marches-list .places a {
    color: var(--color-primary);
  }

  .marches-list .places li {
    padding: 0.15rem 0;
  }

  @media (max-width: 900px) {
    .marches-list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 640px) {
    .marches-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .library-card {
    display: grid;
    grid-template-columns: 24rem 1fr;
    gap: 1.5rem;
    align-items: center;
    margin: 1.5rem 0 2.5rem;
    padding: 0;
    overflow: hidden;
  }

  .library-card img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .library-card > div {
    padding: 1.5rem 1.5rem 1.5rem 0;
  }

  .library-card h3 {
    margin-top: 0;
  }

  .library-card p {
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .library-card {
      grid-template-columns: 1fr;
    }

    .library-card > div {
      padding: 0 1.5rem 1.5rem;
    }
  }
</style>
