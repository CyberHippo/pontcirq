---
import BaseLayout from '../layouts/BaseLayout.astro';

const associations = [
  {
    name: 'ACCA de Pontcirq',
    desc: 'Chasse et protection de la faune sauvage.',
    contact: '',
  },
  {
    name: 'Association de Sauvegarde du Patrimoine',
    desc: 'Préservation et valorisation du patrimoine communal.',
    contact: '',
  },
  {
    name: 'Equi-Vox – Le petit ranch',
    desc: 'Activités équestres et loisirs.',
    contact: 'equivox.asso@gmail.com',
  },
  {
    name: "FESTI'PONTCIRQ",
    desc: 'Organisation de festivités et animations locales.',
    contact: 'festipontcirq@gmail.com',
  },
  {
    name: 'La Gariotte, café associatif de Pontcirq',
    desc: 'Café associatif et lieu de convivialité du village.',
    contact: 'lagariottepontcirq@gmail.com',
  },
  {
    name: 'Les amis de Pontcirq',
    desc: 'Animations et loisirs pour les habitants.',
    contact: '',
  },
  {
    name: 'Lo Garric',
    desc: 'Association culturelle.',
    contact: 'francisbarascou@gmail.com',
  },
];

const marches = [
  { day: 'Mardi matin', places: ['Catus à 5 km'] },
  { day: 'Mercredi matin', places: ['Cahors à 20 km', 'Luzech à 9 km'] },
  { day: 'Jeudi matin', places: ['Mercues à 10 km'] },
  { day: 'Vendredi matin', places: ['Prayssac à 12 km'] },
  { day: 'Samedi matin', places: ['Cahors'] },
  { day: 'Dimanche matin', places: ['Espère à 9 km', 'Montcuq à 16 km'] },
];
---

<BaseLayout title="Vie locale" description="Associations et vie locale de la commune de Pontcirq.">
  <h1>Vie locale</h1>

  <section>
    <h2>Associations</h2>
    <ul class="assoc-list">
      {associations.map((assoc) => (
        <li class="card">
          <h3>{assoc.name}</h3>
          <p>{assoc.desc}</p>
          {assoc.contact && <p class="contact">{assoc.contact}</p>}
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Marchés du coin</h2>
    <p class="section-intro">Aucun marché à Pontcirq même, mais plusieurs marchés hebdomadaires à proximité.</p>
    <ul class="marches-list">
      {marches.map((marche) => (
        <li class="card">
          <h3>{marche.day}</h3>
          <ul class="places">
            {marche.places.map((place) => <li>{place}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Patrimoine</h2>
    <p>
      Pontcirq s'est bâti au flanc d'une anse couronnée de bois, offrant une vue harmonieuse sur la vallée.
      Le hameau de Tourniac conserve un très beau four à pain, vestige du patrimoine rural de la commune.
    </p>
  </section>

  <section>
    <h2>Bibliothèque</h2>
    <div class="card library-card">
      <img src="/images/vie-locale/bibliotheque.jpg" alt="Intérieur de la bibliothèque de Pontcirq" />
      <div>
        <h3>Bibliothèque de Pontcirq</h3>
        <p>Située au hameau de Tourniac.</p>
        <p>
          <a href="https://www.facebook.com/bibliothequepontcirq/" target="_blank" rel="noopener">
            Suivre la page Facebook &rarr;
          </a>
        </p>
      </div>
    </div>
  </section>

  <section>
    <h2>École</h2>
    <p>
      Les enfants de Pontcirq sont scolarisés au sein du regroupement pédagogique intercommunal (RPI),
      en école maternelle et élémentaire. Ramassage scolaire assuré par le Conseil départemental du Lot.
    </p>
  </section>
</BaseLayout>

<style>
  .assoc-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2.5rem;
  }

  .assoc-list h3 {
    margin-top: 0;
  }

  .assoc-list p {
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .assoc-list .contact {
    margin-top: 0.5rem;
    font-size: 0.85rem;
  }

  .section-intro {
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .marches-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2.5rem;
  }

  .marches-list h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    color: var(--color-primary);
  }

  .marches-list .places {
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .marches-list .places li {
    padding: 0.15rem 0;
  }

  .library-card {
    display: grid;
    grid-template-columns: 16rem 1fr;
    gap: 1.5rem;
    align-items: center;
    margin: 1.5rem 0 2.5rem;
    padding: 0;
    overflow: hidden;
  }

  .library-card img {
    width: 100%;
    height: 100%;
    min-height: 12rem;
    object-fit: cover;
  }

  .library-card > div {
    padding: 1.5rem 1.5rem 1.5rem 0;
  }

  .library-card h3 {
    margin-top: 0;
  }

  .library-card p {
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .library-card {
      grid-template-columns: 1fr;
    }

    .library-card > div {
      padding: 0 1.5rem 1.5rem;
    }
  }
</style>
