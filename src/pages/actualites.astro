---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActualiteCard from '../components/ActualiteCard.astro';
import { getUpcoming, getRecentPast, getArchiveTotalPages } from '../data/actualites';

const upcoming = getUpcoming();
const recentPast = getRecentPast();
const hasArchives = getArchiveTotalPages() > 0;
---

<BaseLayout title="Actualités" description="Actualités et annonces de la commune de Pontcirq.">
  <h1>Actualités</h1>
  <p class="intro">Les événements à venir et les dernières annonces de la commune.</p>

  <section>
    <h2>À venir</h2>
    {upcoming.length > 0 ? (
      <div class="news-list">
        {upcoming.map((item) => <ActualiteCard actualite={item} layout="row" />)}
      </div>
    ) : (
      <p class="empty">Aucun événement prévu pour le moment.</p>
    )}
  </section>

  {recentPast.length > 0 && (
    <section>
      <h2>Passés</h2>
      <div class="news-list" id="past-list">
        {recentPast.map((item) => <ActualiteCard actualite={item} layout="row" />)}

        {hasArchives && (
          <button type="button" class="load-archives" hx-get="/fragments/archives/1/" hx-swap="outerHTML">
            Voir les archives
            <span class="htmx-indicator">Chargement…</span>
          </button>
        )}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .intro {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .empty {
    color: var(--color-text-muted);
    font-style: italic;
    margin-bottom: 2.5rem;
  }

  .news-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 1.25rem 0 3rem;
  }

  /* Also styles the button and end message swapped in from the archive fragments. */
  .news-list :global(.load-archives) {
    align-self: center;
    padding: 0.7rem 1.5rem;
    border: 1px solid var(--color-primary);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-primary);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .news-list :global(.load-archives:hover) {
    background: var(--color-primary);
    color: #fff;
  }

  .news-list :global(.end-of-list) {
    text-align: center;
    color: var(--color-text-muted);
    font-style: italic;
    margin: 1.5rem 0;
  }
</style>
