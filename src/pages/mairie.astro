---
import BaseLayout from '../layouts/BaseLayout.astro';

const elus = [{ role: 'Maire', name: 'Thierry Chatain' }];

const hours = [
  { day: 'Lundi', label: 'Fermé' },
  { day: 'Mardi', label: '14h – 17h' },
  { day: 'Mercredi', label: 'Fermé' },
  { day: 'Jeudi', label: 'Fermé' },
  { day: 'Vendredi', label: '9h – 12h' },
];

const services = [
  {
    title: 'Eau potable',
    desc: 'Syndicat Aquareso (délégataire SOGEDO)',
    href: 'https://sogedo.fr/',
    logo: '/images/services/logo-sogedo.jpg',
  },
  {
    title: 'Assainissement collectif',
    desc: 'Syndicat Aquareso — exploitation SOGEDO',
    href: 'https://www.aquareso.fr',
    logo: '/images/services/logo-aquareso.png',
  },
  {
    title: 'Assainissement non-collectif',
    desc: 'Grand Cahors (SPANC)',
    href: 'https://cahorsagglo.fr',
    logo: '/images/services/logo-spanc.jpg',
  },
  {
    title: 'Déchets ménagers et recyclables',
    desc: 'Collecte le vendredi · recyclables un mardi sur deux (tous les mardis en juillet-août) · SYDED du Lot',
    href: 'https://www.syded-lot.fr',
    logo: '/images/services/logo-syded.png',
  },
];

const demarches = [
  {
    title: 'État civil',
    items: [
      {
        label: "Carte nationale d'identité",
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/N358',
      },
      {
        label: 'Passeport',
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/N360',
      },
      {
        label: "Copie d'acte de naissance",
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/F1427',
      },
      {
        label: "Copie d'acte de mariage",
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/F1432',
      },
      {
        label: "Copie d'acte de décès",
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/F1444',
      },
    ],
  },
  {
    title: 'Urbanisme',
    items: [
      {
        label: 'Permis de construire',
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/F1986',
      },
      {
        label: 'Déclaration préalable de travaux',
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/F17578',
      },
      {
        label: "Certificat d'urbanisme",
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/F1633',
      },
    ],
  },
  {
    title: 'Élections',
    items: [
      {
        label: 'Inscription sur les listes électorales',
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/R16396',
      },
      {
        label: 'Procuration de vote',
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/F1604',
      },
    ],
  },
  {
    title: 'Vie quotidienne',
    items: [
      {
        label: 'Recensement citoyen (16 ans)',
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/F870',
      },
      {
        label: "Inscription à l'école",
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/N54',
      },
      {
        label: 'Demande de branchement eau/assainissement',
        href: 'https://aquareso.fr/demarches/',
      },
    ],
  },
];
---

<BaseLayout title="La Mairie" description="Horaires, contact et élus de la mairie de Pontcirq (46150).">
  <h1>La Mairie de Pontcirq</h1>

  <section class="grid">
    <div class="card">
      <h2>Coordonnées</h2>
      <p>
        Adresse : <a href="geo:44.5476,1.2628?q=530+Route+du+Bourg%2C+46150+Pontcirq">530 Route du Bourg, 46150 Pontcirq</a>
      </p>
      <p>Téléphone : <a href="tel:+33565362478">05 65 36 24 78</a></p>
      <p>Email : <a href="mailto:mairie.de.pontcirq@wanadoo.fr">mairie.de.pontcirq@wanadoo.fr</a></p>
      <div class="map-embed">
        <iframe
          title="Carte de localisation de Pontcirq"
          src="https://www.openstreetmap.org/export/embed.html?bbox=1.2328%2C44.5226%2C1.2928%2C44.5726&layer=mapnik&marker=44.5476%2C1.2628"
          loading="lazy"
        ></iframe>
      </div>
      <p>
        <a href="https://www.openstreetmap.org/relation/123870" target="_blank" rel="noopener">
          Voir le contour de la commune sur OpenStreetMap &rarr;
        </a>
      </p>
    </div>

    <div class="grid-col">
      <div class="card">
        <h2>Horaires d'ouverture</h2>
        <table>
          <tbody>
            {hours.map((h) => (
              <tr>
                <td>{h.day}</td>
                <td class={h.label !== 'Fermé' ? 'is-open' : ''}>{h.label}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="card">
        <h2>Maire</h2>
        <ul class="elus">
          {elus.map((elu) => (
            <li>
              <span>{elu.name}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section>
    <h2>Services publics</h2>
    <ul class="services">
      {services.map((service) => (
        <li>
          <a class="card service-card" href={service.href} target="_blank" rel="noopener">
            <div class="service-logo">
              <img src={service.logo} alt="" loading="lazy" />
            </div>
            <strong>{service.title}</strong>
            <span>{service.desc}</span>
            <span class="service-link">Site officiel &rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="demarches">
    <h2>Démarches administratives</h2>
    <div class="intro-row">
      <p class="intro">
        La plupart des démarches d'état civil et d'urbanisme peuvent être initiées en ligne sur
        <a href="https://www.service-public.gouv.fr" target="_blank" rel="noopener">service-public.fr</a>,
        ou directement auprès du secrétariat de mairie.
      </p>
      <a href="https://www.service-public.gouv.fr" target="_blank" rel="noopener" class="intro-logo">
        <img src="/images/services/logo-service-public.svg" alt="Service-public.fr" />
      </a>
    </div>

    <div class="demarches-grid">
      {demarches.map((group) => (
        <div class="card">
          <h3>{group.title}</h3>
          <ul>
            {group.items.map((item) => (
              <li>
                <a href={item.href} target="_blank" rel="noopener">{item.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>


<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin: 1.5rem 0;
  }

  .grid-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    height: 100%;
  }

  .grid-col .card:first-child {
    flex-grow: 1;
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  table td {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  table td:last-child {
    text-align: right;
    color: var(--color-text-muted);
  }

  table td.is-open {
    color: var(--color-primary);
    font-weight: 700;
  }

  .elus {
    list-style: none;
    padding: 0;
  }

  .elus li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2.5rem;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--color-text);
    height: 100%;
  }

  .service-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    color: var(--color-text);
  }

  .service-logo {
    height: 2.5rem;
    display: flex;
    align-items: center;
    margin-bottom: 0.25rem;
  }

  .service-logo img {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: left;
  }

  .services span {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .service-card .service-link {
    margin-top: 0.5rem;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .map-embed {
    margin: 1rem 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .map-embed iframe {
    width: 100%;
    height: 220px;
    border: 0;
    display: block;
  }

  .intro-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .intro {
    max-width: 42rem;
    color: var(--color-text-muted);
  }

  .intro-logo {
    display: block;
  }

  .intro-logo img {
    width: 24rem;
    height: auto;
  }

  .demarches-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin: 1.5rem 0 3rem;
  }

  @media (max-width: 640px) {
    .demarches-grid {
      grid-template-columns: 1fr;
    }
  }

  .demarches-grid h3 {
    margin-top: 0;
  }

  .demarches-grid ul {
    padding-left: 1.2rem;
  }

  .demarches-grid li {
    margin-bottom: 0.4rem;
  }

  .demarches-grid li a {
    color: var(--color-primary);
  }
</style>
