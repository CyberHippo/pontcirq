---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import carte from '../assets/mairie/carte-pontcirq.png';
import { address, phone, email, hours, CLOSED } from '../data/mairie';

const elus = [{ role: 'Maire', name: 'Thierry Chatain' }];

const services = [
  {
    title: 'Eau potable',
    desc: 'Syndicat Aquareso (délégataire SOGEDO)',
    href: 'https://sogedo.fr/',
    logo: '/images/services/logo-sogedo.jpg',
  },
  {
    title: 'Assainissement collectif',
    desc: 'Syndicat Aquareso — exploitation SOGEDO',
    href: 'https://www.aquareso.fr',
    logo: '/images/services/logo-aquareso.png',
  },
  {
    title: 'Assainissement non-collectif',
    desc: 'Grand Cahors (SPANC)',
    href: 'https://cahorsagglo.fr',
    logo: '/images/services/logo-spanc.jpg',
  },
  {
    title: 'Déchets ménagers et recyclables',
    desc: 'Collecte le vendredi · recyclables un mardi sur deux (tous les mardis en juillet-août) · SYDED du Lot',
    href: 'https://www.syded-lot.fr',
    logo: '/images/services/logo-syded.png',
  },
];

const demarches = [
  {
    title: 'État civil',
    items: [
      {
        label: "Carte nationale d'identité",
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/N358',
      },
      {
        label: 'Passeport',
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/N360',
      },
      {
        label: "Copie d'acte de naissance",
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/F1427',
      },
      {
        label: "Copie d'acte de mariage",
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/F1432',
      },
      {
        label: "Copie d'acte de décès",
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/F1444',
      },
    ],
  },
  {
    title: 'Urbanisme',
    items: [
      {
        label: 'Permis de construire',
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/F1986',
      },
      {
        label: 'Déclaration préalable de travaux',
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/F17578',
      },
      {
        label: "Certificat d'urbanisme",
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/F1633',
      },
    ],
  },
  {
    title: 'Élections',
    items: [
      {
        label: 'Inscription sur les listes électorales',
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/R16396',
      },
      {
        label: 'Procuration de vote',
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/F1604',
      },
    ],
  },
  {
    title: 'Vie quotidienne',
    items: [
      {
        label: 'Recensement citoyen (16 ans)',
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/F870',
      },
      {
        label: "Inscription à l'école",
        href: 'https://www.service-public.gouv.fr/particuliers/vosdroits/N54',
      },
      {
        label: 'Demande de branchement eau/assainissement',
        href: 'https://aquareso.fr/demarches/',
      },
    ],
  },
];
---

<BaseLayout title="La Mairie" description="Horaires, contact et élus de la mairie de Pontcirq (46150).">
  <h1>La Mairie de Pontcirq</h1>

  <section class="grid">
    <div class="card">
      <h2>Coordonnées</h2>
      <p>
        Adresse : <a href={address.href}>{address.label}</a>
      </p>
      <p>Téléphone : <a href={phone.href}>{phone.label}</a></p>
      <p>Email : <a href={email.href}>{email.label}</a></p>
      <a
        class="map-embed"
        href="https://www.openstreetmap.org/?mlat=44.5476&mlon=1.2628#map=14/44.5476/1.2628"
        target="_blank"
        rel="noopener"
      >
        <Image
          src={carte}
          alt="Carte du bourg de Pontcirq et des environs : la mairie est marquée au centre. Ouvrir la carte interactive sur OpenStreetMap"
          widths={[480, 960]}
          sizes="(max-width: 720px) 100vw, 36rem"
        />
      </a>
      <p>
        <a href="https://www.openstreetmap.org/relation/123870" target="_blank" rel="noopener">
          Voir le contour de la commune sur OpenStreetMap &rarr;
        </a>
      </p>
    </div>

    <div class="grid-col">
      <div class="card">
        <h2>Horaires d'ouverture</h2>
        <table>
          <tbody>
            {hours.map((h) => (
              <tr>
                <td>{h.day}</td>
                <td class={h.label !== CLOSED ? 'is-open' : ''}>{h.label}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="card">
        <h2>Maire</h2>
        <ul class="elus">
          {elus.map((elu) => (
            <li>
              <span>{elu.name}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="salle-communale">
    <h2>Location de la salle communale</h2>
    <div class="card salle-card">
      <p class="salle-intro">
        La salle communale (salle des fêtes), située dans le bourg, peut être louée pour vos fêtes de famille,
        repas et événements associatifs.
      </p>
      <dl class="salle-facts">
        <div>
          <dt>Adresse</dt>
          <dd><a href={address.href}>Le Bourg, 46150 Pontcirq</a></dd>
        </div>
        <div>
          <dt>Capacité</dt>
          <dd>90 personnes</dd>
        </div>
        <div>
          <dt>Tarif</dt>
          <dd>de 75 € à 90 €</dd>
        </div>
        <div>
          <dt>Réservation</dt>
          <dd><a href="tel:+33672028518">06 72 02 85 18</a></dd>
        </div>
      </dl>
      <p class="salle-note">
        Renseignements sur les disponibilités et les conditions de location auprès de la mairie, par téléphone
        ou par email à <a href={email.href}>{email.label}</a>.
      </p>
    </div>
  </section>

  <section>
    <h2>Services publics</h2>
    <ul class="services">
      {services.map((service) => (
        <li>
          <a class="card service-card" href={service.href} target="_blank" rel="noopener">
            <div class="service-logo">
              <img src={service.logo} alt="" loading="lazy" />
            </div>
            <strong>{service.title}</strong>
            <span>{service.desc}</span>
            <span class="service-link">Site officiel &rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="grand-pass">
    <h2>Carte Grand Pass</h2>
    <div class="card grand-pass-card">
      <p>
        Gratuite et nominative, la carte Grand Pass du Grand Cahors est proposée à tous les habitants de
        l'agglomération, donc aux Pontcirquois. Elle donne accès à des tarifs préférentiels :
      </p>
      <ul>
        <li>piscines, médiathèque, ludothèque et conservatoire du Grand Cahors ;</li>
        <li>spectacles, concerts (Auditorium, Les Docks) et visites guidées ;</li>
        <li>offres ponctuelles des partenaires de l'agglomération.</li>
      </ul>
      <p>
        Elle permet aussi de retirer les sacs jaunes de tri à l'Hôtel administratif Wilson.
      </p>
      <h3>Comment l'obtenir</h3>
      <p>
        Chaque membre de la famille doit avoir sa propre carte. Présentez-vous avec une pièce d'identité (ou le
        livret de famille pour les enfants) et un justificatif de domicile de moins de trois mois :
      </p>
      <ul>
        <li>
          à l'Hôtel administratif Wilson, 72 rue du Président Wilson à Cahors, du lundi au vendredi de 8h30 à
          11h45 et de 13h30 à 16h30 ;
        </li>
        <li>ou à la médiathèque du Grand Cahors, 185 avenue Jean-Jaurès à Cahors.</li>
      </ul>
      <p>
        <a href="https://cahorsagglo.fr/ma-carte-grand-pass" target="_blank" rel="noopener">
          Tous les avantages sur le site du Grand Cahors &rarr;
        </a>
      </p>
    </div>
  </section>

  <section id="demarches">
    <h2>Démarches administratives</h2>
    <div class="intro-row">
      <p class="intro">
        La plupart des démarches d'état civil et d'urbanisme peuvent être initiées en ligne sur
        <a href="https://www.service-public.gouv.fr" target="_blank" rel="noopener">service-public.fr</a>,
        ou directement auprès du secrétariat de mairie.
      </p>
      <a href="https://www.service-public.gouv.fr" target="_blank" rel="noopener" class="intro-logo">
        <img src="/images/services/logo-service-public.svg" alt="Service-public.fr" />
      </a>
    </div>

    <div class="demarches-grid">
      {demarches.map((group) => (
        <div class="card">
          <h3>{group.title}</h3>
          <ul>
            {group.items.map((item) => (
              <li>
                <a href={item.href} target="_blank" rel="noopener">{item.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>


<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin: 1.5rem 0;
  }

  .grid-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    height: 100%;
  }

  .grid-col .card:first-child {
    flex-grow: 1;
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  table td {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  table td:last-child {
    text-align: right;
    color: var(--color-text-muted);
  }

  table td.is-open {
    color: var(--color-primary);
    font-weight: 700;
  }

  .elus {
    list-style: none;
    padding: 0;
  }

  .elus li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .salle-card {
    margin: 1.5rem 0 2.5rem;
  }

  .salle-intro,
  .salle-note {
    margin: 0;
    color: var(--color-text-muted);
  }

  .salle-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    margin: 1.25rem 0;
  }

  .salle-facts div {
    background: var(--color-primary-light);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
  }

  .salle-facts dt {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .salle-facts dd {
    margin: 0.15rem 0 0;
    font-weight: 700;
    color: var(--color-primary-dark);
  }

  .salle-facts dd a {
    color: inherit;
  }

  .services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2.5rem;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--color-text);
    height: 100%;
  }

  .service-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    color: var(--color-text);
  }

  .service-logo {
    height: 2.5rem;
    display: flex;
    align-items: center;
    margin-bottom: 0.25rem;
  }

  .service-logo img {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: left;
  }

  .services span {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .service-card .service-link {
    margin-top: 0.5rem;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .grand-pass-card {
    margin: 1.5rem 0 2.5rem;
    max-width: 48rem;
  }

  .grand-pass-card p,
  .grand-pass-card li {
    color: var(--color-text-muted);
  }

  .grand-pass-card p:first-child {
    margin-top: 0;
  }

  .grand-pass-card p:last-child {
    margin-bottom: 0;
  }

  .grand-pass-card h3 {
    margin: 1.25rem 0 0.5rem;
    font-size: 1.05rem;
  }

  .grand-pass-card li {
    margin-bottom: 0.3rem;
  }

  .grand-pass-card a {
    font-weight: 600;
  }

  .map-embed {
    display: block;
    margin: 1rem 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .map-embed img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
  }

  .intro-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .intro {
    max-width: 42rem;
    color: var(--color-text-muted);
  }

  .intro-logo {
    display: block;
  }

  .intro-logo img {
    width: 24rem;
    height: auto;
  }

  .demarches-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin: 1.5rem 0 3rem;
  }

  @media (max-width: 640px) {
    .demarches-grid {
      grid-template-columns: 1fr;
    }
  }

  .demarches-grid h3 {
    margin-top: 0;
  }

  .demarches-grid ul {
    padding-left: 1.2rem;
  }

  .demarches-grid li {
    margin-bottom: 0.4rem;
  }

  .demarches-grid li a {
    color: var(--color-primary);
  }
</style>
