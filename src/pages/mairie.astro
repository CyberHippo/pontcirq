---
import BaseLayout from '../layouts/BaseLayout.astro';

const elus = [{ role: 'Maire', name: 'Thierry Chatain' }];

const hours = [
  { day: 'Lundi', label: 'Fermé', dow: 1, open: null },
  { day: 'Mardi', label: '14h – 17h', dow: 2, open: [14, 17] },
  { day: 'Mercredi', label: 'Fermé', dow: 3, open: null },
  { day: 'Jeudi', label: 'Fermé', dow: 4, open: null },
  { day: 'Vendredi', label: '9h – 12h', dow: 5, open: [9, 12] },
];

const services = [
  {
    title: 'Eau potable',
    desc: 'Syndicat Aquareso (délégataire SOGEDO)',
    href: 'https://www.aquareso.fr',
    logo: '/images/services/logo-aquareso.png',
  },
  {
    title: 'Assainissement collectif',
    desc: 'Syndicat Aquareso — exploitation SOGEDO',
    href: 'https://www.aquareso.fr',
    logo: '/images/services/logo-sogedo.jpg',
  },
  {
    title: 'Assainissement non-collectif',
    desc: 'Grand Cahors (SPANC)',
    href: 'https://cahorsagglo.fr',
    logo: '/images/services/logo_spanc.jpg',
  },
  {
    title: 'Déchets ménagers et recyclables',
    desc: 'Collecte le vendredi · recyclables un mardi sur deux (tous les mardis en juillet-août) · SYDED du Lot',
    href: 'https://www.syded-lot.fr',
    logo: '/images/services/logo-syded.png',
  },
];
---

<BaseLayout title="La Mairie" description="Horaires, contact et élus de la mairie de Pontcirq (46150).">
  <h1>La Mairie de Pontcirq</h1>

  <section class="grid">
    <div class="card">
      <h2>Coordonnées</h2>
      <p>
        Adresse : <a href="geo:44.5476,1.2628?q=530+Route+du+Bourg%2C+46150+Pontcirq">530 Route du Bourg, 46150 Pontcirq</a>
      </p>
      <p>Téléphone : <a href="tel:+33565362478">05 65 36 24 78</a></p>
      <p>Email : <a href="mailto:mairie.de.pontcirq@wanadoo.fr">mairie.de.pontcirq@wanadoo.fr</a></p>
      <div class="map-embed">
        <iframe
          title="Carte de localisation de Pontcirq"
          src="https://www.openstreetmap.org/export/embed.html?bbox=1.2328%2C44.5226%2C1.2928%2C44.5726&layer=mapnik&marker=44.5476%2C1.2628"
          loading="lazy"
        ></iframe>
      </div>
      <p>
        <a href="https://www.openstreetmap.org/relation/123870" target="_blank" rel="noopener">
          Voir le contour de la commune sur OpenStreetMap &rarr;
        </a>
      </p>
    </div>

    <div class="card">
      <h2>Horaires d'ouverture</h2>
      <table id="hours-table">
        <tbody>
          {hours.map((h) => (
            <tr data-dow={h.dow} data-open={h.open ? h.open.join('-') : ''}>
              <td>{h.day}</td>
              <td>{h.label}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="card">
      <h2>Maire</h2>
      <ul class="elus">
        {elus.map((elu) => (
          <li>
            <strong>{elu.role}</strong>
            <span>{elu.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section>
    <h2>Services publics</h2>
    <ul class="services">
      {services.map((service) => (
        <li>
          <a class="card service-card" href={service.href} target="_blank" rel="noopener">
            <div class="service-logo">
              <img src={service.logo} alt="" loading="lazy" />
            </div>
            <strong>{service.title}</strong>
            <span>{service.desc}</span>
            <span class="service-link">Site officiel &rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<script>
  function highlightOpenHours() {
    const now = new Date();
    const dow = now.getDay();
    const hour = now.getHours() + now.getMinutes() / 60;

    document.querySelectorAll<HTMLTableRowElement>('#hours-table tr').forEach((row) => {
      const rowDow = Number(row.dataset.dow);
      const openRange = row.dataset.open;
      let isOpen = false;

      if (rowDow === dow && openRange) {
        const [start, end] = openRange.split('-').map(Number);
        isOpen = hour >= start && hour < end;
      }

      row.classList.toggle('is-open', isOpen);
    });
  }

  highlightOpenHours();
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    align-items: start;
    gap: 1.5rem;
    margin: 1.5rem 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  table td {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  table td:last-child {
    text-align: right;
    color: var(--color-text-muted);
  }

  table tr.is-open td {
    color: var(--color-primary);
    font-weight: 700;
  }

  .elus {
    list-style: none;
    padding: 0;
  }

  .elus li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2.5rem;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--color-text);
    height: 100%;
  }

  .service-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    color: var(--color-text);
  }

  .service-logo {
    height: 2.5rem;
    display: flex;
    align-items: center;
    margin-bottom: 0.25rem;
  }

  .service-logo img {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: left;
  }

  .services span {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .service-card .service-link {
    margin-top: 0.5rem;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .map-embed {
    margin: 1rem 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .map-embed iframe {
    width: 100%;
    height: 220px;
    border: 0;
    display: block;
  }
</style>
