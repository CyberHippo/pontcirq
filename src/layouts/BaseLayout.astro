---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource-variable/inter';
import '../styles/global.css';
import defaultImage from '../assets/accueil/pontcirq-1.jpg';

interface Props {
  title: string;
  description?: string;
  /** Social preview image (an image from src/assets), resized for og:image at build time */
  image?: ImageMetadata;
  type?: 'website' | 'article';
}

const {
  title,
  description = "Site officiel de la commune de Pontcirq (46150), dans le Lot.",
  image = defaultImage,
  type = 'website',
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
// 1200px wide JPEG for link previews; `fit` makes sharp skip upscaling sources narrower than that.
const ogImage = await getImage({ src: image, width: 1200, fit: 'inside', format: 'jpg' });
const imageUrl = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Pontcirq" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/images/pontcirq-blason.png" />
    <link rel="alternate" type="application/rss+xml" title="Actualités de Pontcirq" href="/rss.xml" />
    <title>{title} · Pontcirq</title>
    <script>
      import 'htmx.org';
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu" class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
