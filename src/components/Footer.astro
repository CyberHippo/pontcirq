---
import { address, phone, email, openingHours } from '../data/mairie';

const year = new Date().getFullYear();

const partners = [
  {
    src: '/images/footer/republique-francaise.svg',
    alt: 'République française',
    href: 'https://www.info.gouv.fr/',
  },
  {
    src: '/images/footer/departement-lot.png',
    alt: 'Département du Lot',
    href: 'https://www.lot.fr',
  },
  {
    src: '/images/footer/region-occitanie.png',
    alt: 'Région Occitanie',
    href: 'https://www.laregion.fr',
  },
  {
    src: '/images/footer/grand-cahors.png',
    alt: 'Grand Cahors',
    href: 'https://cahorsagglo.fr',
  },
  {
    src: '/images/footer/oh-my-lot.png',
    alt: 'Oh My Lot! — Tourisme Lot',
    href: 'https://www.tourisme-lot.com',
  },
  {
    src: '/images/footer/vallees-lot-dordogne-occitanie.png',
    alt: 'Vallées Lot & Dordogne',
    href: 'https://www.valleesdordogne.com',
  },
];
---

<footer>
  <div class="container footer-inner">
    <div>
      <strong>Mairie de Pontcirq</strong>
      <p>
        <a href={address.href}>{address.label}</a>
      </p>
      <p><a href={phone.href}>{phone.label}</a></p>
      <p><a href={email.href}>{email.label}</a></p>
    </div>
    <div>
      <strong>Horaires d'ouverture</strong>
      {openingHours.map((h) => <p>{h.day} : {h.label}</p>)}
    </div>
    <div>
      <strong>Liens utiles</strong>
      <ul>
        <li><a href="/mairie">La mairie</a></li>
        <li><a href="/mairie#demarches">Démarches administratives</a></li>
        <li><a href="/mentions-legales">Mentions légales</a></li>
      </ul>
    </div>
  </div>
  <div class="container partners">
    {partners.map((partner) => (
      <a class="partner-logo" href={partner.href} target="_blank" rel="noopener">
        <img src={partner.src} alt={partner.alt} loading="lazy" />
      </a>
    ))}
  </div>
  <div class="container copyright">
    <p>
      &copy; {year} Commune de Pontcirq &mdash; Site non officiel réalisé à titre d'exemple.
      <a href="/mentions-legales">Mentions légales</a>
    </p>
  </div>
</footer>

<style>
  footer {
    background: var(--color-primary-dark);
    color: #eef2ea;
    margin-top: 3rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    padding-top: 2.5rem;
    padding-bottom: 2rem;
  }

  .footer-inner strong {
    font-weight: 700;
    color: #fff;
    display: block;
    margin-bottom: 0.5rem;
  }

  .footer-inner p {
    margin: 0.2rem 0;
    color: #cdd8c6;
    font-size: 0.9rem;
  }

  .footer-inner ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-inner a {
    color: #cdd8c6;
    font-size: 0.9rem;
  }

  .partners {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 2rem 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .partner-logo {
    background: #fff;
    border-radius: var(--radius-sm);
    padding: 1rem 1.5rem;
    height: 6rem;
    display: flex;
    align-items: center;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .partner-logo:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .partner-logo img {
    height: 100%;
    width: auto;
    max-width: 17rem;
    object-fit: contain;
  }

  .copyright {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding: 1rem 1.5rem;
    font-size: 0.8rem;
    color: #a9b6a1;
  }

  .copyright a {
    color: #a9b6a1;
    margin-left: 0.75rem;
  }

  .copyright a:hover {
    color: #fff;
  }
</style>
