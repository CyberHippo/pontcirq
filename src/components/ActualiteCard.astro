---
import { formatActualiteDate, type Actualite } from '../data/actualites';

interface Props {
  actualite: Actualite;
  layout?: 'grid' | 'row';
  showImage?: boolean;
}

const { actualite, layout = 'grid', showImage = true } = Astro.props;
const formattedDate = formatActualiteDate(actualite);
---

<a class={`card news-item news-item--${layout}`} href={`/actualites/${actualite.id}`}>
  <div class="news-item-body">
    <time datetime={actualite.date}>{formattedDate}</time>
    <h3>{actualite.title}</h3>
    <p>{actualite.excerpt}</p>
  </div>
  {showImage && actualite.image && (
    <div class="news-item-preview">
      <img src={actualite.image} alt="" loading="lazy" />
    </div>
  )}
</a>

<style>
  .news-item {
    display: block;
    color: var(--color-text);
    padding: 0;
    overflow: hidden;
    height: 100%;
  }

  .news-item:hover {
    color: var(--color-text);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .news-item--grid {
    display: flex;
    flex-direction: column-reverse;
    height: 100%;
  }

  .news-item--grid .news-item-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .news-item--grid .news-item-body p {
    flex-grow: 1;
  }

  .news-item--grid .news-item-preview {
    aspect-ratio: 16 / 9;
  }

  .news-item--row {
    display: grid;
    grid-template-columns: 1fr 18rem;
    align-items: stretch;
  }

  .news-item--row .news-item-preview {
    min-height: 100%;
  }

  .news-item-preview {
    overflow: hidden;
  }

  .news-item-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .news-item-body {
    padding: 1.75rem;
  }

  .news-item time {
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .news-item h3 {
    margin: 0.4rem 0;
  }

  .news-item p {
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (max-width: 640px) {
    .news-item--row {
      grid-template-columns: 1fr;
    }

    .news-item--row .news-item-preview {
      aspect-ratio: 16 / 9;
    }
  }
</style>
