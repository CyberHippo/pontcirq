---
import { formatActualiteDate, type Actualite } from '../data/actualites';

interface Props {
  actualite: Actualite;
  layout?: 'grid' | 'row';
  showImage?: boolean;
  showAssociation?: boolean;
}

const { actualite, layout = 'grid', showImage = true, showAssociation = true } = Astro.props;
const formattedDate = formatActualiteDate(actualite);
---

<div class={`card news-item news-item--${layout}`}>
  <a class="news-item-link" href={`/actualites/${actualite.id}`}></a>
  <div class="news-item-body">
    <time datetime={actualite.date}>{formattedDate}</time>
    <h3>{actualite.title}</h3>
    <p class="excerpt">{actualite.excerpt}</p>
    <span class="news-item-more">En savoir plus &rarr;</span>
    {showAssociation && actualite.associations && actualite.associations.length > 0 && (
      <p class="news-item-assoc">
        Organisé par
        {' '}
        {actualite.associations.map((assoc, i) => (
          <>
            {i > 0 && ' et '}
            <a href={`/vie-locale#${assoc.anchor}`}>{assoc.name}</a>
          </>
        ))}
      </p>
    )}
  </div>
  {showImage && actualite.image && (
    <div class="news-item-preview">
      <img src={actualite.image} alt="" loading="lazy" />
    </div>
  )}
</div>

<style>
  .news-item {
    position: relative;
    display: block;
    color: var(--color-text);
    padding: 0;
    overflow: hidden;
    height: 100%;
  }

  .news-item:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .news-item-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .news-item--grid {
    display: flex;
    flex-direction: column-reverse;
    height: 100%;
  }

  .news-item--grid .news-item-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }


  .news-item--grid .news-item-preview {
    aspect-ratio: 16 / 9;
  }

  .news-item--row {
    display: grid;
    grid-template-columns: 1fr 18rem;
    align-items: stretch;
  }

  .news-item--row .news-item-body {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .news-item--row .news-item-preview {
    min-height: 100%;
  }

  .news-item-preview {
    overflow: hidden;
  }

  .news-item-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .news-item-body {
    padding: 1.75rem;
  }

  .news-item time {
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .news-item h3 {
    margin: 0.4rem 0;
  }

  .news-item p {
    color: var(--color-text-muted);
    margin: 0;
  }

  .news-item-more {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .news-item p.news-item-assoc {
    position: relative;
    z-index: 2;
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.85rem;
  }

  .news-item-assoc a {
    position: relative;
    color: var(--color-primary);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .news-item--row {
      grid-template-columns: 1fr;
    }

    .news-item--row .news-item-preview {
      aspect-ratio: 16 / 9;
    }
  }
</style>
