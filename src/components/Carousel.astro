---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Slide {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
---

<div
  class="carousel"
  role="region"
  aria-roledescription="carrousel"
  aria-label="Photos de Pontcirq"
  data-carousel
>
  <div class="carousel-track" aria-live="off" data-carousel-track>
    {slides.map((slide, i) => (
      <div
        class="carousel-slide"
        role="group"
        aria-roledescription="photo"
        aria-label={`${i + 1} sur ${slides.length}`}
      >
        <Image
          src={slide.src}
          alt={slide.alt}
          widths={[640, 1080]}
          sizes="(max-width: 72rem) 100vw, 72rem"
          quality={75}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
        />
      </div>
    ))}
  </div>

  <button class="carousel-nav prev" type="button" aria-label="Photo précédente" data-carousel-prev>
    &larr;
  </button>
  <button class="carousel-nav next" type="button" aria-label="Photo suivante" data-carousel-next>
    &rarr;
  </button>

  <button
    class="carousel-toggle"
    type="button"
    aria-label="Mettre en pause le défilement"
    data-carousel-toggle
  >
    <span aria-hidden="true" data-carousel-toggle-icon>&#10074;&#10074;</span>
  </button>

  <div class="carousel-dots" data-carousel-dots>
    {slides.map((_, i) => (
      <button
        type="button"
        class="carousel-dot"
        aria-label={`Aller à la photo ${i + 1}`}
        data-carousel-dot={i}
      ></button>
    ))}
  </div>
</div>

<script>
  function initCarousels() {
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
      if (carousel.dataset.carouselInit === 'true') return;
      carousel.dataset.carouselInit = 'true';

      const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.carousel-slide'));
      const dots = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-dot]'));
      const prevBtn = carousel.querySelector<HTMLElement>('[data-carousel-prev]');
      const nextBtn = carousel.querySelector<HTMLElement>('[data-carousel-next]');
      if (!track || slides.length === 0) return;

      const toggleBtn = carousel.querySelector<HTMLElement>('[data-carousel-toggle]');
      const toggleIcon = carousel.querySelector<HTMLElement>('[data-carousel-toggle-icon]');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      let index = 0;
      // Autoplay is opt-in when the user prefers reduced motion (WCAG 2.2.2)
      let userPaused = reducedMotion;
      let hovered = false;
      let focused = false;
      let autoplay: ReturnType<typeof setInterval> | undefined;

      const setActive = (i: number) => {
        index = (i + slides.length) % slides.length;
        track.scrollTo({ left: slides[index].offsetLeft, behavior: reducedMotion ? 'auto' : 'smooth' });
        dots.forEach((dot, di) => {
          dot.classList.toggle('active', di === index);
          if (di === index) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
      };

      const updateAutoplay = () => {
        const shouldRun = !userPaused && !hovered && !focused;
        if (shouldRun && autoplay === undefined) {
          autoplay = setInterval(() => setActive(index + 1), 5000);
        } else if (!shouldRun && autoplay !== undefined) {
          clearInterval(autoplay);
          autoplay = undefined;
        }
        // Announce slide changes only when they are not automatic
        track.setAttribute('aria-live', shouldRun ? 'off' : 'polite');
      };

      const updateToggle = () => {
        if (!toggleBtn || !toggleIcon) return;
        toggleBtn.setAttribute(
          'aria-label',
          userPaused ? 'Lancer le défilement' : 'Mettre en pause le défilement',
        );
        toggleIcon.textContent = userPaused ? '\u25B6\uFE0E' : '\u275A\u275A';
      };

      prevBtn?.addEventListener('click', () => setActive(index - 1));
      nextBtn?.addEventListener('click', () => setActive(index + 1));
      dots.forEach((dot, di) => dot.addEventListener('click', () => setActive(di)));
      toggleBtn?.addEventListener('click', () => {
        userPaused = !userPaused;
        updateToggle();
        updateAutoplay();
      });

      carousel.addEventListener('mouseenter', () => {
        hovered = true;
        updateAutoplay();
      });
      carousel.addEventListener('mouseleave', () => {
        hovered = false;
        updateAutoplay();
      });
      carousel.addEventListener('focusin', () => {
        focused = true;
        updateAutoplay();
      });
      carousel.addEventListener('focusout', (event) => {
        if (carousel.contains(event.relatedTarget as Node | null)) return;
        focused = false;
        updateAutoplay();
      });

      updateToggle();
      updateAutoplay();
      setActive(0);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarousels);
  } else {
    initCarousels();
  }
  document.addEventListener('astro:page-load', initCarousels);
</script>

<style>
  .carousel {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .carousel-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .carousel-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    aspect-ratio: 21 / 9;
  }

  .carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .carousel-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.85);
    border: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    font-size: 1.1rem;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: background-color 0.15s ease;
  }

  .carousel-nav:hover {
    background: #fff;
  }

  .carousel-nav.prev {
    left: 1rem;
  }

  .carousel-nav.next {
    right: 1rem;
  }

  .carousel-toggle {
    position: absolute;
    right: 1rem;
    bottom: 0.6rem;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.85);
    color: var(--color-text);
    border: none;
    border-radius: 999px;
    font-size: 0.75rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: background-color 0.15s ease;
  }

  .carousel-toggle:hover {
    background: #fff;
  }

  .carousel-dots {
    position: absolute;
    bottom: 1rem;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }

  .carousel-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    border: none;
    background: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    padding: 0;
  }

  .carousel-dot.active {
    background: #fff;
    transform: scale(1.2);
  }

  .carousel-nav:focus-visible,
  .carousel-toggle:focus-visible,
  .carousel-dot:focus-visible {
    outline: 3px solid #fff;
    box-shadow: 0 0 0 6px var(--color-primary-dark);
  }

  @media (max-width: 640px) {
    .carousel-nav {
      width: 2rem;
      height: 2rem;
      font-size: 0.95rem;
    }
  }
</style>
